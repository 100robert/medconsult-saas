# Archivo de Variables de Entorno - Ejemplo

# ============================================
# RAÍZ DEL PROYECTO
# ============================================
# Este archivo debe copiarse como .env en la raíz

# Base de Datos Compartida (PostgreSQL)
DATABASE_URL="postgresql://usuario:password@localhost:5432/medconsult_db"

# JWT Secrets (deben ser distintos y seguros en producción)
JWT_SECRET="tu_secreto_super_seguro_aqui_cambialo"
JWT_REFRESH_SECRET="otro_secreto_diferente_para_refresh"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ============================================
# SERVICIOS BACKEND
# ============================================

# Auth Service
AUTH_SERVICE_PORT=3001

# Appointments Service  
APPOINTMENTS_SERVICE_PORT=3002

# Payments Service
PAYMENTS_SERVICE_PORT=3003

# Reviews Service
REVIEWS_SERVICE_PORT=3004

# ============================================
# FRONTEND
# ============================================
# Crear como .env.local en /frontend

NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# CONFIGURACIONES ADICIONALES
# ============================================

# Email (para notificaciones - opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_de_app

# Jitsi (Videoconsultas)
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=vpaas-magic-cookie-xxxxx

# Gateway de Pagos (Culqi - Producción)
CULQI_PUBLIC_KEY=pk_test_xxxxx
CULQI_SECRET_KEY=sk_test_xxxxx

# Logs
LOG_LEVEL=debug
NODE_ENV=development
